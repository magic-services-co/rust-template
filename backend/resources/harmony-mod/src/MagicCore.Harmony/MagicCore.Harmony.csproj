<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>MagicCore</RootNamespace>
    <AssemblyName>MagicCore</AssemblyName>
    <OutputType>Library</OutputType>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <Version>2.1.2</Version>
    <Authors>Magic Services / Vinni P.</Authors>
    <Description>Harmony mod for Magic template leaderboards, linking, bans, and Oxide/Carbon group sync.</Description>
    <LangVersion>10.0</LangVersion>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591;CS0618</NoWarn>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(RustManagedDir)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Rust.Harmony">
      <HintPath>$(RustManagedDir)\Rust.Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="netstandard">
      <HintPath>$(RustManagedDir)\netstandard.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(RustManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.UnityEngine">
      <HintPath>$(RustManagedDir)\Facepunch.UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Console">
      <HintPath>$(RustManagedDir)\Facepunch.Console.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.Network">
      <HintPath>$(RustManagedDir)\Facepunch.Network.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Facepunch.System">
      <HintPath>$(RustManagedDir)\Facepunch.System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(RustManagedDir)\Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(RustManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.PhysicsModule">
      <HintPath>$(RustManagedDir)\UnityEngine.PhysicsModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Net.Http">
      <HintPath>$(RustManagedDir)\System.Net.Http.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="WarnMissingManaged" BeforeTargets="ResolveAssemblyReferences">
    <Warning Condition="!Exists('$(RustManagedDir)\Assembly-CSharp.dll')"
             Text="Rust managed assemblies were not found in '$(RustManagedDir)'. Copy RustDedicated_Data/Managed into ./Managed or set RUST_MANAGED_DIR." />
  </Target>
</Project>
